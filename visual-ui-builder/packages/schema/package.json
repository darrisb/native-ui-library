{
  "name": "@visual-ui/schema",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Schema graph inputs for Visual UI Builder",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "node dist/__tests__/parse.test.js && node dist/__tests__/list-page.test.js && node dist/__tests__/live-graph.test.js"
  },
  "dependencies": {
    "@visual-ui/core": "^0.2.0"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.tsbuildinfo"
  ]
}
